<section class="user">
  <h1><%= @user.name %></h1>
  <h2><%= mail_to(@user.email) %></h2>
  <p>Member since <%= time_ago_in_words(@user.created_at) %> ago</p>
  <% if current_user?(@user) %>
    <div class="actions">
      <%= link_to "Edit", edit_user_path(@user), class: "button edit" %>
      <%= link_to "Delete", @user, data: { turbo_method: :delete }, confirm: "Are you sure?", class: "button delete" %>
    </div>
  <% end %>
  <% if @registrations.any? %>
    <h1>Registrations</h1>
    <div class="table-responsive">
      <table class='table table-striped table-bordered'>
        <thead>
        <tr>
          <th>Event</th>
          <th>Registration Date</th>
        </tr>
        </thead>
        <tbody>
        <% @registrations.each do |r| %>
          <tr>
            <td><%= link_to r.event.name, r.event %></td>
            <td><%= r.created_at.strftime("%B %d, %Y") %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No registrations yet.</p>
  <% end %>
</section>